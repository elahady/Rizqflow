APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email (kode verifikasi Daftar dan Lupa kata sandi). Lokal: log (kode muncul di storage/logs).
# Produksi: Brevo SMTP, lihat DEPLOY.md "Email produksi (Brevo)". Isi nilai rahasia hanya di .env.production.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Rizqflow"

# Contoh produksi (Brevo SMTP): nilai username/kunci SMTP diambil dari dashboard Brevo, JANGAN di-commit.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="noreply@mail.roziqrizal.com"
# MAIL_FROM_NAME="Rizqflow"

# Saklar Daftar/verifikasi/Lupa kata sandi lewat email. Kosong = otomatis (menyala bila MAIL_MAILER bukan
# log/array, atau APP_ENV local/testing). Paksa dengan true/false.
# EMAIL_CODES_ENABLED=
# Batas email per hari di paket pengirim (Brevo gratis 300); pemilik diberi tahu di 80% lewat OWNER_EMAIL.
# MAIL_DAILY_LIMIT=300
# OWNER_EMAIL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Client ID Web Google yang sama dengan Android (ID publik, bukan rahasia). Lihat docs/auth-google.md.
GOOGLE_CLIENT_ID=232915442214-5fusjgtntn65tdg34km2ppra9ee6k1ka.apps.googleusercontent.com
