<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- KHUSUS DEBUG (Tahap 12). Target SDK 37 memblokir lalu lintas http polos (cleartext) secara bawaan,
         padahal build debug perlu memanggil server pengembang lewat http: emulator (http://10.0.2.2:8000),
         HP fisik lewat LAN (http://192.168.x.x:8000), atau adb reverse (http://localhost:8000). Berkas ini
         hanya ikut di build debug; build rilis tidak punya network security config sama sekali dan
         usesCleartextTraffic="false" di manifest utama, jadi rilis tetap hanya https. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
