<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notifikasi pengingat malam (S26); wajib diminta saat dijalankan di Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pindai undangan QR ruang keluarga (Tahap 9/13); diminta saat runtime, hanya saat layar itu dibuka. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- allowBackup dimatikan: salinan otomatis tidak boleh keluar dari kendali pengguna.
         Cadangan dibuat lewat backup terenkripsi milik aplikasi (lihat docs/konsep.md). -->
    <application
        android:name=".RizqflowApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Rizqflow">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Rizqflow.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Pintasan ikon (tekan lama): Catat kilat. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Tile Quick Settings: Catat kilat. Pengguna menambahkannya sendiri dari panel. -->
        <service
            android:name=".QuickCatatTileService"
            android:exported="true"
            android:icon="@drawable/ic_quick_catat"
            android:label="@string/tile_catat_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Widget layar utama "Sisa aman hari ini" (Pro). Tanggal, jam, dan zona waktu berubah menyegarkannya
             supaya sisa aman ikut berganti hari; siaran itu dikecualikan dari pembatasan penerima manifest. -->
        <receiver
            android:name=".widget.SafeToSpendWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/safe_to_spend_widget_info" />
        </receiver>

        <!-- Aksi notifikasi pengingat malam (Balas, Tidak ada): dipicu lewat PendingIntent, bukan intent tersirat. -->
        <receiver
            android:name=".notifications.ReminderActionReceiver"
            android:exported="false" />
    </application>

</manifest>
